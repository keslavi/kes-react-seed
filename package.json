{
  "name": "react-seed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "node ./scripts/copy-mock-data.js && vite --port 3000 --host",
    "mock": "node ./scripts/copy-mock-data.js",
    "devWithConsoleDebug": "vite port 3000 --host --inspect --debug",
    "test": "vitest --ui --watch",
    "test:commit": "vitest run",
    "build:formhelper": "node ./scripts/build-formhelper-assets.js",
    "build:render": "npm run build:formhelper && npm run build",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:secure": "node ./scripts/build-secure.js",
    "build:server": "cd server-koa && npm install && npm run build",
    "build:all": "npm run build && npm run build:server",
    "postbuild": "node ./scripts/copy-mock-data.js && node ./scripts/set-config-override.js true ./dist/config-override.js",
    "copy:mock": "node ./scripts/copy-mock-data.js",
    "start:prod": "cd server-koa && npm run start:prod",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepare": "husky || true",
    "zzzvzalidate:prompts": "node validate-prompt-context.js"
  },
  "overrides": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "prop-types": "^15.8.1",
    "@mui/utils": {
      "react-is": "^19.1.0"
    },
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.10",
    "CommentedNeededInArtifactory": {
      "picomatch": "4.0.2",
      "micromatch": {
        "picomatch": "2.3.1"
      },
      "anymatch": {
        "picomatch": "2.3.1"
      },
      "cosmicconfig": {
        "yaml": "1.10.2"
      }
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^9.1.1",
    "@mui/lab": "^9.0.0-beta.5",
    "@mui/material": "^9.1.2",
    "@mui/styled-engine-sc": "^9.1.1",
    "@mui/utils": "^9.1.1",
    "@mui/x-data-grid": "^9.7.0",
    "@mui/x-date-pickers": "^9.7.0",
    "@swc/plugin-emotion": "^11.0.2",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "axios": "^1.15.1",
    "dayjs": "^1.11.19",
    "kes-formhelper-mui": "^0.1.3",
    "lodash": "^4.18.1",
    "msw": "^2.10.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.61.1",
    "react-router-dom": "^7.14.2",
    "react-toastify": "^11.0.5",
    "sass": "^1.89.2",
    "vitest": "^4.1.10",
    "yup": "^1.7.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^3.1.1"
  }
}
